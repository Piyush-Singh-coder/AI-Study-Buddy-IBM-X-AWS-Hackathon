# Google Gemini API Key (Free tier & Embeddings)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_TEXT_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# NVIDIA NIM Free API Key (https://build.nvidia.com)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_TEXT_MODEL=nvidia/nemotron-3.5-bolt-e4b

# OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TEXT_MODEL=google/gemini-2.0-flash-001

# Active LLM Provider: "nvidia", "openrouter", "gemini", or "bedrock"
LLM_PROVIDER=nvidia

# Auth Security Secret
SECRET_KEY=ai-study-buddy-secret-key-2026-production

# Neon Serverless PostgreSQL Database Endpoint
DATABASE_URL=postgresql://neondb_owner:password@ep-host.us-east-1.aws.neon.tech/neondb?sslmode=require
